{
  "manifest_version": 3,
  "name": "GPT Image Studio",
  "version": "0.3.0",
  "description": "ChatGPT image generation side panel: generate, edit and review images, backed by the local aigpt server (uv run aigpt-api). Click the toolbar icon to open.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "sidePanel", "webNavigation", "nativeMessaging", "clipboardWrite"],
  "host_permissions": [
    "https://platform.openai.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1:8788/*",
    "http://127.0.0.1:8789/*"
  ],
  "side_panel": {
    "default_path": "iframe.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GPT Image Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
